    {
        "id": "bb116787f0449957",
        "type": "function",
        "z": "8d4205de0d327950",
        "name": "function 4",
        "func": "let dados = msg.freguesia;\nlet temp = msg.payload.main.temp;\nlet rating = dados[\"Mean(review_scores_rating)\"];\nlet preco = dados[\"Mean(preco_noite)\"];\n\nlet classificacao = \"👍 Zona Tranquila\"; \n\nif (rating >= 4.7 && preco <= 120) {\n    classificacao = \"⭐ Escolha Ideal\";\n} else if (temp >= 17 && preco <= 130) {\n    classificacao = \"☀️ Recomendado para Passeio & Bom Preço\";\n} else if (preco > 150) {\n    classificacao = \"💎 Zona Premium\";\n}\n\nmsg.payload = [\n    { _id: dados._id }, \n    {\n        $set: {\n            temp_c: temp,\n            classificacao_zona: classificacao\n        }\n    }\n];\nreturn msg;",
