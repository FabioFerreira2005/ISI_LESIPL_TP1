    {
        "id": "cb4955fac46d5b3b",
        "type": "function",
        "z": "8d4205de0d327950",
        "name": "function 1",
        "func": "let pontos = [];\nlet lista = Array.isArray(msg.payload) ? msg.payload : [msg.payload];\nlet contagem = {}; \n\nlista.forEach(item => {\n    let freguesia = item.nome_corrigido;\n\n    if (!contagem[freguesia]) {\n        contagem[freguesia] = 0;\n    }\n\n    if (contagem[freguesia] < 10 && item.latitude && item.longitude) {\n        pontos.push({\n            name: String(item.id) + \" - \" + item.name,\n            lat: Number(item.latitude),\n            lon: Number(item.longitude),\n            icon: \"bed\",\n            iconColor: \"blue\",\n            \"Preço\": item.price + \" €\",\n            \"Tipo de Aloj.\": item.room_type,\n            \"Freguesia\": freguesia\n        });\n        \n        contagem[freguesia]++; \n    }\n});\n\nmsg.payload = pontos;\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
